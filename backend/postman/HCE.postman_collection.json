      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Servicios y SQL Server disponibles', function () { pm.expect(pm.response.json().status).to.equal('ok'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
