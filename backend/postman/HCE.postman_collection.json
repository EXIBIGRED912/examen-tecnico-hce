            "key": "Origin",
            "value": "{{frontendOrigin}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "Iniciar sesión",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('lot', 'POSTMAN-' + pm.variables.replaceIn('{{$guid}}'));",
              "pm.collectionVariables.set('purchaseKey', pm.variables.replaceIn('{{$guid}}'));",
              "pm.collectionVariables.set('saleKey', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('JWT de 30 minutos', function () { pm.expect(pm.response.json().expiresIn).to.equal(1800); });",
              "pm.test('Cookie HttpOnly', function () { pm.expect(pm.response.headers.get('Set-Cookie')).to.match(/\\bHttpOnly\\b/i); });"
            ]
          }
        }
      ],
